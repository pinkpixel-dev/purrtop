<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
  "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Pink Pixel</vendor>
  <vendor_url>https://pinkpixel.dev</vendor_url>

  <!-- purrtop-helper only accepts purrtop's five admin actions (signals,
       nice, CPU affinity, stack samples, port owners) and checks every
       argument. auth_admin_keep remembers the password for a few minutes. -->
  <action id="dev.pinkpixel.purrtop.run-helper">
    <description>Manage processes and read system details with purrtop</description>
    <message>purrtop needs administrator rights to act on a process you don't own or to read details only root can see</message>
    <icon_name>dev.pinkpixel.Purrtop</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/purrtop/purrtop-helper</annotate>
  </action>
</policyconfig>
